# NEXT_PUBLIC_*: variables visibles en cliente y servidor (no sensibles)
# URL base del backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Identificador público de la app OAuth de Discord
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Guild ID del servidor de Discord
NEXT_PUBLIC_DISCORD_GUILD_ID=

# --- SOLO SERVIDOR (nunca prefijo NEXT_PUBLIC_) ---
# Secret de la OAuth app de Discord
DISCORD_CLIENT_SECRET=

# Secreto para cifrar cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET=